
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Ticket - Campus IT Help Desk</title>

    <!-- Load Bootstrap and the project stylesheet -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/stylesheets/style.css" rel="stylesheet">
</head>

<body>

    <!-- Navigation bar -->
    <nav class="navbar navbar-dark bg-dark p-3">
        <div class="container">
            <a class="navbar-brand" href="/">Campus IT Help Desk</a>
        </div>
    </nav>

    <!-- Ticket submission form -->
    <div class="container mt-5 mb-5">
        <h1>Create a Support Ticket</h1>
        <p>Fill in the details below to report your technical issue.</p>

        <% if (success) { %>
            <div class="alert alert-success">
                Your support ticket has been submitted successfully.

                <a href="/dashboard" class="btn btn-primary mt-3">
                    View Submitted Tickets
                </a>

                <a href="/" class="btn btn-secondary mt-3">
                    Return Home
                </a>

                
            </div>
        <% } %>
    

        <form action="/tickets" method="POST">

            <!-- Student name -->
            <div class="mb-3">
                <label for="studentName" class="form-label">Full Name</label>
                <input type="text" class="form-control"
                       id="studentName" name="studentName" required>
            </div>

            <!-- Student email -->
            <div class="mb-3">
                <label for="email" class="form-label">Student Email</label>
                <input type="email" class="form-control"
                       id="email" name="email" required>
            </div>

            <!-- Type of technical issue -->
            <div class="mb-3">
                <label for="category" class="form-label">Issue Category</label>
                <select class="form-select" id="category" name="category" required>
                    <option value="">Select a category</option>
                    <option value="Wi-Fi">Wi-Fi / Internet</option>
                    <option value="Hardware">Hardware</option>
                    <option value="Software">Software</option>
                    <option value="Account">Account / Login</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <!-- Description of the problem -->
            <div class="mb-3">
                <label for="description" class="form-label">Describe the Issue</label>
                <textarea class="form-control" id="description"
                          name="description" rows="5" required></textarea>
            </div>

            <!-- Submit the ticket -->
            <button type="submit" class="btn btn-primary">
                Submit Ticket
            </button>

            <a href="/" class="btn btn-outline-secondary ms-2">Cancel</a>

        </form>
    </div>

</body>
</html>
