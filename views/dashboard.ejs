
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Ticket Status Dashboard</title>

    <!-- Bootstrap styling -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <!-- Navigation bar -->
    <nav class="navbar navbar-dark bg-dark p-3">
        <div class="container">
            <a class="navbar-brand" href="/">
                Campus IT Help Desk
            </a>
        </div>
    </nav>

    <div class="container mt-5">

        <h1>Ticket Status Dashboard</h1>
        <p>View and track submitted IT support tickets.</p>

        <a href="/" class="btn btn-secondary">Home</a>
        <a href="/tickets/new" class="btn btn-primary">
            Create Ticket
        </a>

        <hr>

        <!-- Count tickets by status -->
        <%
            var openCount = 0;
            var progressCount = 0;
            var resolvedCount = 0;

            tickets.forEach(function(ticket) {
                if (ticket.status === 'Open') {
                    openCount++;
                } else if (ticket.status === 'In Progress') {
                    progressCount++;
                } else if (ticket.status === 'Resolved') {
                    resolvedCount++;
                }
            });
        %>

        <!-- Ticket counters -->
        <div class="row mt-4">

            <div class="col-md-3 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5>Total Tickets</h5>
                        <h2><%= tickets.length %></h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5>Open</h5>
                        <h2><%= openCount %></h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5>In Progress</h5>
                        <h2><%= progressCount %></h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5>Resolved</h5>
                        <h2><%= resolvedCount %></h2>
                    </div>
                </div>
            </div>

        </div>

        <!-- Ticket table -->
        <h3 class="mt-4">Support Tickets</h3>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Ticket ID</th>
                        <th>Student Name</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    <% tickets.forEach(function(ticket) { %>
                        <tr>
                            <td><%= ticket.id %></td>
                            <td><%= ticket.studentName %></td>
                            <td><%= ticket.category %></td>
                            <td><%= ticket.description %></td>

                            <td>
                                <% if (ticket.status === 'Open') { %>
                                    <span class="badge bg-warning text-dark">
                                        Open
                                    </span>
                                <% } else if (ticket.status === 'In Progress') { %>
                                    <span class="badge bg-primary">
                                        In Progress
                                    </span>
                                <% } else if (ticket.status === 'Resolved') { %>
                                    <span class="badge bg-success">
                                        Resolved
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-secondary">
                                        <%= ticket.status %>
                                    </span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>

            </table>
        </div>

        <% if (tickets.length === 0) { %>
            <p>No support tickets have been submitted yet.</p>
        <% } %>

    </div>

</body>
</html>
